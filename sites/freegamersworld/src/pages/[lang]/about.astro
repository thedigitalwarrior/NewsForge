---
import type { GetStaticPaths } from "astro";
import BaseLayout from "@shared/layouts/BaseLayout.astro";
import { locales, type Locale } from "@shared/i18n/config";
import { aboutUrl } from "@shared/i18n/routes";
import { useTranslations } from "@shared/i18n/ui";
import { site } from "../../config/site";

export const getStaticPaths = (async () => {
  return locales.map((lang) => ({ params: { lang } }));
}) satisfies GetStaticPaths;

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);

const alternates: Partial<Record<Locale, string>> = {};
for (const l of locales) alternates[l] = aboutUrl(l);

const content: Record<Locale, { intro: string; ai: string; sources: string }> = {
  en: {
    intro: `${site.name} tracks the games given away for free on the Epic Games Store, Steam, GOG and Prime Gaming, so you never miss a claim window. No clickbait, just what's free and until when.`,
    ai: "Our articles are produced with the help of AI tools, under human supervision. AI helps gather and summarize giveaway details from multiple sources; verifying the offer, its dates and publishing remain human decisions.",
    sources:
      "Every article links to the official store page for the giveaway. We do not copy or closely paraphrase others' work: we produce original summaries with the key facts — what's free, on which platform, and the deadline to claim it. Cover images are the games' official store artwork, used to illustrate the news.",
  },
  it: {
    intro: `${site.name} tiene traccia dei giochi regalati su Epic Games Store, Steam, GOG e Prime Gaming, così non ti sfugge nessuna finestra di riscatto. Niente clickbait, solo cosa è gratis e fino a quando.`,
    ai: "I nostri articoli sono realizzati con l'ausilio di strumenti di intelligenza artificiale, sotto supervisione umana. L'AI aiuta a raccogliere e sintetizzare i dettagli delle offerte da più fonti; la verifica dell'offerta, delle date e la pubblicazione restano decisioni umane.",
    sources:
      "Ogni articolo rimanda alla pagina ufficiale dello store per l'offerta. Non copiamo né parafrasiamo da vicino il lavoro altrui: produciamo sintesi originali con i fatti essenziali — cosa è gratis, su quale piattaforma ed entro quando riscattarlo. Le immagini di copertina sono gli artwork ufficiali degli store, usate a scopo illustrativo.",
  },
};
const c = content[lang];
---

<BaseLayout
  site={site}
  lang={lang}
  title={t("nav.about")}
  alternates={alternates}
>
  <div class="mx-auto max-w-3xl px-4 py-10">
    <div class="prose prose-lg prose-gray max-w-none">
      <h1>{t("nav.about")}</h1>
      <p>{c.intro}</p>
      <h2>{lang === "it" ? "Il ruolo dell'AI" : "The role of AI"}</h2>
      <p>{c.ai}</p>
      <h2>{lang === "it" ? "Le fonti" : "Sources"}</h2>
      <p>{c.sources}</p>
    </div>
  </div>
</BaseLayout>
